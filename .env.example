# Local Postgres from docker-compose.yml (pnpm db:up)
DATABASE_URL="postgresql://focused:focused@localhost:5434/focused"

# Cloudflare R2 photo storage (bucket: Object Read & Write token scoped to it).
# R2_JURISDICTION is set when the bucket was created in a jurisdiction (eu).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
R2_JURISDICTION=""
