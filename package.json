{
  "name": "focused",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec postgres psql -U focused -d focused",
    "db:codegen": "kysely-codegen --env-file .env.local --dialect postgres --exclude-pattern '{kysely_*,v_*}' --out-file src/db/types.ts",
    "db:codegen:check": "kysely-codegen --env-file .env.local --dialect postgres --exclude-pattern '{kysely_*,v_*}' --out-file src/db/types.ts --verify",
    "db:migrate": "node scripts/migrate.mts",
    "db:migrate:prod": "node scripts/migrate.mts --prod",
    "db:import:lens-db": "node scripts/import-lens-db.mts",
    "db:import:lensfun": "node scripts/import-lensfun.mts",
    "db:seed": "node scripts/seed.mts",
    "db:seed:prod": "node scripts/seed.mts --prod",
    "db:seed:cities": "node scripts/seed-cities.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "heic-to": "^1.6.6",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@next/env": "^16.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
