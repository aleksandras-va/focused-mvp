{
  "name": "focused",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec postgres psql -U focused -d focused",
    "db:codegen": "kysely-codegen --env-file .env.local --dialect postgres --exclude-pattern '{kysely_*,v_*}' --out-file src/db/types.ts",
    "db:codegen:check": "kysely-codegen --env-file .env.local --dialect postgres --exclude-pattern '{kysely_*,v_*}' --out-file src/db/types.ts --verify",
    "db:seed": "node scripts/seed.mts",
    "db:seed:cities": "node scripts/seed-cities.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "kysely": "^0.29.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@next/env": "^16.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1"
}
