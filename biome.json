{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/db/types.ts",
      "!src/components/ui/*.tsx",
      "src/components/ui/city-select.tsx",
      "src/components/ui/discount-badge.tsx",
      "src/components/ui/logo.tsx",
      "src/components/ui/empty-state.tsx",
      "src/components/ui/scroll-to-top.tsx",
      "src/components/ui/preconnect.tsx",
      "src/components/ui/json-ld.tsx",
      "src/components/ui/record-visit-source.tsx",
      "src/components/ui/submit-button.tsx",
      "!src/lib/utils.ts",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
